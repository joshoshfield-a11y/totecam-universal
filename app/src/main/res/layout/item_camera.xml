<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp"
    android:background="#1C232B" android:layout_margin="6dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView
            android:id="@+id/itemName"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" />
        <TextView
            android:id="@+id/itemBadge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#FFFFFF" android:padding="4dp"
            android:background="#1565C0" android:layout_marginEnd="8dp" />
        <Button
            android:id="@+id/itemDelete"
            android:layout_width="42dp" android:layout_height="wrap_content"
            android:minWidth="0dp" android:padding="0dp" android:text="✕" />
    </LinearLayout>

    <TextView
        android:id="@+id/itemSub"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#9AA4AD"
        android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
